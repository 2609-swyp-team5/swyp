# 이 프로젝트는 dotenv 로더를 사용하지 않아 .env 파일을 자동으로 읽지 않습니다.
# 이 파일을 backend/.env 로 복사한 뒤, 아래 중 하나의 방법으로 직접 주입하세요 (.env는 git에 커밋되지 않습니다):
#   - 셸: export $(grep -v '^#' backend/.env | xargs) 후 ./gradlew bootRun
#   - IntelliJ: Run Configuration의 EnvFile 플러그인 등으로 backend/.env 지정
#   - Docker: docker run --env-file backend/.env ...
# 값이 없는 항목은 application-{profile}.yaml 에 기본값이 없어 실행 시 필수로 채워야 합니다

# ==========================================
# 활성 프로파일 (local / dev / prod)
# ==========================================
SPRING_PROFILES_ACTIVE=local

# ==========================================
# 데이터베이스 (local은 기본값으로 H2 사용, dev/prod는 필수)
# ==========================================
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/swyp
DB_USERNAME=myuser
DB_PASSWORD=mypassword

# ==========================================
# JWT (local은 미설정 시 기본 시크릿 사용, dev/prod는 필수)
# ==========================================
JWT_SECRET=
JWT_REFRESH_SECRET=

# ==========================================
# CORS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ==========================================
# 파일 업로드 (Multipart)
# ==========================================
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# ==========================================
# 파일 스토리지 (STORAGE_PROVIDER: R2 / LOCAL / NAVER / S3, 기본값은 R2)
# 로컬 개발에서 클라우드 자격증명 없이 쓰려면 아래처럼 LOCAL로 지정하세요
# ==========================================
STORAGE_PROVIDER=LOCAL
LOCAL_STORAGE_DIR=uploads
LOCAL_STORAGE_BASE_URL=http://localhost:8080

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# 네이버 클라우드 Object Storage
NAVER_STORAGE_ENDPOINT=
NAVER_STORAGE_REGION=
NAVER_STORAGE_ACCESS_KEY=
NAVER_STORAGE_SECRET_KEY=
NAVER_STORAGE_BUCKET=
NAVER_STORAGE_PUBLIC_BASE_URL=

# AWS S3
AWS_S3_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# ==========================================
# 운영 로깅 (prod 전용)
# ==========================================
LOG_PATH=./logs
