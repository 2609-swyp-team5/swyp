{
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "eslint.workingDirectories": [{ "directory": "frontend" }],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][scss][markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  "[java]": {
    "editor.tabSize": 4
  },

  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "backend[\\\\/]src[\\\\/].*\\.java$",
        "isAsync": true,
        "cmd": "\"${workspaceFolder}\\backend\\gradlew.bat\" -p \"${workspaceFolder}\\backend\" spotlessApply -q"
      }
    ]
  }
}
